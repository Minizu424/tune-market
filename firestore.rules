rules_version = '2';

// Tune Market MVP 用の最低限のセキュリティルール（課題作成用資料 20時間目に対応）
// - ログインしていないユーザーは書き込みできない
// - 自分の users / holdings しか書き換えられない
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }

    match /artists/{artistId} {
      allow read: if true;
      // 本人の登録・更新のほか、応援によるポイント加算を許可（MVP簡易版）
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn();
    }

    match /songs/{songId} {
      allow read: if true;
      // 投稿・編集・（購入/応援による）カウンタ更新。MVPでは署名済みユーザーに許可
      allow create, update: if signedIn();
    }

    match /holdings/{holdingId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /supports/{supportId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /priceHistories/{historyId} {
      allow read: if true;
      allow create: if signedIn();
    }

    match /progressUpdates/{updateId} {
      allow read: if true;
      allow create: if signedIn();
    }
  }
}
